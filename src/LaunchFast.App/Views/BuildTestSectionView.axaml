<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LaunchFast.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="LaunchFast.App.Views.BuildTestSectionView"
             x:DataType="vm:BuildTestSectionViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource Surface0Brush}">

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,11">
                <Button Grid.Column="1" Classes="btn" Margin="0,0,8,0" Content="Run tests"
                        IsEnabled="{Binding CanRunTests}"
                        Command="{Binding RunTestsCommand}" />
                <Button Grid.Column="2" Classes="accent" Content="Build (gym)"
                        IsEnabled="{Binding CanBuild}"
                        Command="{Binding BuildCommand}" />
            </Grid>
        </Border>

        <!-- Subbar -->
        <Border DockPanel.Dock="Top" Classes="subbar">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="h2" Text="Build &amp; Test" />
                <Border Grid.Column="1" Classes="chip" Margin="14,0,8,0">
                    <TextBlock Text="{Binding ChipText}" />
                </Border>
                <StackPanel Grid.Column="3" Classes="synced" Orientation="Horizontal" Spacing="7">
                    <Border Classes="synced-dot" />
                    <TextBlock Text="{Binding SyncedText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Two-column content -->
        <Grid ColumnDefinitions="*,360">

            <!-- LEFT column — Build settings · gym -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer>
                    <StackPanel Margin="20,16,20,20" Spacing="14">

                        <TextBlock Classes="blk-t" Text="BUILD SETTINGS · GYM" />

                        <!-- Real gym config (Gymfile / Fastfile build_app) -->
                        <Border Classes="panel">
                            <StackPanel>
                                <Border Classes="dl-row">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Classes="k" Text="Scheme" />
                                        <TextBlock Grid.Column="1" Classes="v" Text="{Binding SchemeText}" />
                                    </Grid>
                                </Border>
                                <Border Classes="dl-row">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Classes="k" Text="Configuration" />
                                        <TextBlock Grid.Column="1" Classes="v" Text="{Binding ConfigurationText}" />
                                    </Grid>
                                </Border>
                                <Border Classes="dl-row">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Classes="k" Text="Clean build" />
                                        <TextBlock Grid.Column="1" Classes="v" Text="{Binding CleanText}" />
                                    </Grid>
                                </Border>
                                <Border Classes="dl-row last">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Classes="k" Text="Include bitcode" />
                                        <TextBlock Grid.Column="1" Classes="v" Text="{Binding IncludeBitcodeText}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Export method (reflects the real export_method) -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="fldlabel" Text="Export method" />
                            <Border Classes="seg" HorizontalAlignment="Left"
                                    IsVisible="{Binding HasBuildSettings}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Classes="seg-item" GroupName="bt-export" Content="app-store"
                                                 IsHitTestVisible="False"
                                                 IsChecked="{Binding ExportAppStore, Mode=OneWay}" />
                                    <RadioButton Classes="seg-item" GroupName="bt-export" Content="ad-hoc"
                                                 IsHitTestVisible="False"
                                                 IsChecked="{Binding ExportAdHoc, Mode=OneWay}" />
                                    <RadioButton Classes="seg-item" GroupName="bt-export" Content="development"
                                                 IsHitTestVisible="False"
                                                 IsChecked="{Binding ExportDevelopment, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Classes="lsub" Text="{Binding ExportMethodText}"
                                       IsVisible="{Binding !HasBuildSettings}" />
                        </StackPanel>

                        <!-- Output -->
                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="13,10">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" FontSize="12"
                                           Foreground="{DynamicResource Text2Brush}"
                                           VerticalAlignment="Center" Text="Output" />
                                <TextBlock Grid.Column="1" FontSize="11.5"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           Foreground="{DynamicResource Text1Brush}"
                                           TextAlignment="Right" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="{Binding OutputPath}" />
                            </Grid>
                        </Border>

                        <TextBlock FontSize="11" Foreground="{DynamicResource Text3Brush}"
                                   IsVisible="{Binding !HasBuildSettings}"
                                   Text="No Gymfile or build_app call found — gym not configured." />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT column — Tests · scan -->
            <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}">
                <ScrollViewer>
                    <StackPanel Margin="18,16,18,20" Spacing="14">

                        <TextBlock Classes="blk-t" Text="TESTS · SCAN" />

                        <!-- Real scan config (Scanfile / Fastfile run_tests) -->
                        <Border Classes="panel">
                            <StackPanel>
                                <Border Classes="dl-row">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Classes="k" Text="Scheme" />
                                        <TextBlock Grid.Column="1" Classes="v" Text="{Binding TestSchemeText}" />
                                    </Grid>
                                </Border>
                                <Border Classes="dl-row">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Classes="k" Text="Test plan" />
                                        <TextBlock Grid.Column="1" Classes="v" Text="{Binding TestPlanText}" />
                                    </Grid>
                                </Border>
                                <Border Classes="dl-row last">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Classes="k" Text="Devices" />
                                        <TextBlock Grid.Column="1" Classes="v" TextWrapping="Wrap"
                                                   Text="{Binding DevicesText}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Last test run -->
                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="blk-t" Text="LAST TEST RUN" />
                                <TextBlock Grid.Column="1" Classes="blk-x" Text="{Binding LastRunMeta}" />
                            </Grid>

                            <!-- Real parsed JUnit results -->
                            <Border Classes="panel" Padding="14" IsVisible="{Binding HasResults}">
                                <StackPanel Spacing="14">
                                    <!-- Stat row -->
                                    <Grid ColumnDefinitions="*,*,*">
                                        <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding PassedCount}" FontSize="26"
                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource GreenBrush}" />
                                            <TextBlock Text="Passed" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Text2Brush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding FailedCount}" FontSize="26"
                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource RedBrush}" />
                                            <TextBlock Text="Failed" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Text2Brush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SkippedCount}" FontSize="26"
                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource AmberBrush}" />
                                            <TextBlock Text="Skipped" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Text2Brush}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Progress bar (red track, green pass fraction) -->
                                    <Border Height="6" CornerRadius="3"
                                            Background="{DynamicResource TintRedBrush}"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding PassStar}" />
                                                <ColumnDefinition Width="{Binding RemainderStar}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="3"
                                                    Background="{DynamicResource GreenBrush}" />
                                            <Border Grid.Column="1" Background="Transparent" />
                                        </Grid>
                                    </Border>

                                    <!-- Per-suite result rows -->
                                    <ItemsControl ItemsSource="{Binding Results}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TestResultRow">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Classes="pill"
                                                            Classes.ok="{Binding IsPass}"
                                                            Classes.warn="{Binding IsSkip}"
                                                            Classes.bad="{Binding IsFail}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Classes="lsub"
                                                               Margin="9,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Grid.Column="2" Classes="lmeta"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Count}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Empty state -->
                            <Border Classes="panel" Padding="14" IsVisible="{Binding !HasResults}">
                                <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,10">
                                    <TextBlock HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Text2Brush}"
                                               TextAlignment="Center"
                                               Text="{Binding EmptyResultsText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </DockPanel>
</UserControl>
