<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LaunchFast.App.ViewModels"
             xmlns:conv="using:LaunchFast.App.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="LaunchFast.App.Views.ScreenshotsSectionView"
             x:DataType="vm:ScreenshotsSectionViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource Surface0Brush}">

    <UserControl.Resources>
        <conv:PathToBitmapConverter x:Key="PathToBitmap" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,11">
                <Button Grid.Column="1" Classes="btn" Margin="0,0,8,0"
                        Content="Preview all"
                        IsEnabled="{Binding CanPreview}"
                        Click="OnPreviewAll" />
                <Button Grid.Column="2" Classes="accent" Content="Run snapshot"
                        IsEnabled="{Binding CanRunSnapshot}"
                        Command="{Binding RunSnapshotCommand}" />
            </Grid>
        </Border>

        <!-- Subbar -->
        <Border DockPanel.Dock="Top" Classes="subbar">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="h2" Text="Screenshots" />
                <Border Grid.Column="1" Classes="chip" Margin="14,0,8,0">
                    <TextBlock Text="{Binding ChipText}" />
                </Border>
                <StackPanel Grid.Column="3" Classes="synced" Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="{Binding SyncedText}"
                               Foreground="{DynamicResource Text3Brush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Two-column content -->
        <Grid ColumnDefinitions="*,360">

            <!-- LEFT column -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer>
                    <StackPanel Margin="20,16,20,20" Spacing="16">

                        <!-- Devices block -->
                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="blk-t" Text="DEVICES" />
                                <TextBlock Grid.Column="1" Classes="blk-x"
                                           Text="{Binding DevicesSelectedText}" />
                            </Grid>
                            <Border Classes="listcard">
                                <ItemsControl ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SnapshotDeviceRow">
                                            <Border Classes="lrow">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                                        <TextBlock Classes="ltitle" Text="{Binding Name}" />
                                                        <TextBlock Classes="lsub" Text="{Binding Sub}" />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1" Classes="tgl"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding On, Mode=TwoWay}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Classes="lsub" Text="{Binding DevicesNote}" />
                        </StackPanel>

                        <!-- Languages block -->
                        <StackPanel Spacing="9">
                            <TextBlock Classes="blk-t" Text="LANGUAGES" />
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        IsVisible="{Binding HasLanguages}">
                                <ItemsControl ItemsSource="{Binding Languages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LanguageChip">
                                            <Border Classes="chip">
                                                <TextBlock Text="{Binding Code}" VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Classes="lsub" Text="{Binding LanguagesNote}" />
                        </StackPanel>

                        <!-- Capture block -->
                        <StackPanel Spacing="9">
                            <TextBlock Classes="blk-t" Text="CAPTURE" />
                            <StackPanel Spacing="6">
                                <TextBlock Classes="fldlabel" Text="UI test scheme" />
                                <TextBox Classes="inp" IsReadOnly="True"
                                         Text="{Binding SchemeText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="fldlabel" Text="Launch arguments" />
                                <TextBox Classes="inp mono-inp" IsReadOnly="True"
                                         Text="{Binding LaunchArgumentsText, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- frameit block -->
                        <StackPanel Spacing="9">
                            <TextBlock Classes="blk-t" Text="FRAMEIT" />
                            <Border Classes="panel">
                                <StackPanel>
                                    <Border Classes="dl-row">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Classes="ltitle" Text="Frame screenshots" />
                                                <TextBlock Classes="lsub" Text="{Binding FrameitText}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" Classes="tgl"
                                                          VerticalAlignment="Center"
                                                          IsEnabled="False"
                                                          IsChecked="{Binding FrameitEnabled, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <Border Classes="dl-row last" IsVisible="{Binding HasFrameTitle}">
                                        <StackPanel Spacing="9">
                                            <TextBlock Classes="ltitle" Text="Title" />
                                            <TextBox Classes="inp" IsReadOnly="True"
                                                     Text="{Binding FrameTitle, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Captured screenshots gallery (real PNGs) -->
                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="blk-t" Text="CAPTURED" />
                                <TextBlock Grid.Column="1" Classes="blk-x"
                                           Text="{Binding CapturedCountText}" />
                            </Grid>

                            <!-- locale switcher (only when more than one locale) -->
                            <ItemsControl ItemsSource="{Binding CapturedLocales}"
                                          IsVisible="{Binding HasMultipleLocales}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Classes="btn ghost small"
                                                Content="{Binding}"
                                                Command="{Binding $parent[ItemsControl].((vm:ScreenshotsSectionViewModel)DataContext).SelectLocaleCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- device-grouped gallery: header + true-ratio WrapPanel per device -->
                            <ItemsControl ItemsSource="{Binding ScreenshotGroups}"
                                          IsVisible="{Binding HasScreenshots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScreenshotDeviceGroup">
                                        <StackPanel Spacing="7">
                                            <TextBlock Classes="ltitle" Text="{Binding Device}" />
                                            <ItemsControl ItemsSource="{Binding Paths}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border CornerRadius="9" Margin="6" ClipToBounds="True"
                                                                BorderThickness="1"
                                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                                Background="{DynamicResource Surface2Brush}">
                                                            <Image Stretch="Uniform" Height="220"
                                                                   Source="{Binding Converter={StaticResource PathToBitmap}}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="lsub" Text="{Binding EmptyGalleryText}"
                                       IsVisible="{Binding !HasScreenshots}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT column -->
            <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}">
                <ScrollViewer>
                    <StackPanel Margin="18,16,18,20" Spacing="16">

                        <!-- Big-number card -->
                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="18,16">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding QueuedCount}" FontSize="32"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Text1Brush}" />
                                <TextBlock Text="{Binding QueuedCaption}" FontSize="11.5"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource Text2Brush}" />
                            </StackPanel>
                        </Border>

                        <!-- Framed device preview composition (illustrative mock) -->
                        <Border CornerRadius="14" Padding="20,22"
                                Background="{DynamicResource AccentBrush}">
                            <StackPanel Spacing="14" HorizontalAlignment="Center">
                                <TextBlock Text="Track every machine in real time"
                                           FontSize="15" FontWeight="SemiBold"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="White" MaxWidth="200" />
                                <!-- White phone mock -->
                                <Border Width="150" Height="220" CornerRadius="20"
                                        Background="White" Padding="10"
                                        BoxShadow="0 6 18 0 #40000000">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="9:41" FontSize="9"
                                                       FontWeight="SemiBold" Foreground="#333" />
                                            <Border Grid.Column="2" Width="14" Height="6" CornerRadius="2"
                                                    Background="#CCC" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Height="70" CornerRadius="9" Background="#E8F4EE" />
                                        <StackPanel Spacing="6">
                                            <Border Height="9" CornerRadius="4" Background="#EEE" />
                                            <Border Height="9" CornerRadius="4" Background="#EEE"
                                                    Width="90" HorizontalAlignment="Left" />
                                            <Border Height="9" CornerRadius="4" Background="#EEE" />
                                            <Border Height="9" CornerRadius="4" Background="#EEE"
                                                    Width="90" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding PreviewNote}" FontSize="11"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource Text3Brush}" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </DockPanel>
</UserControl>
