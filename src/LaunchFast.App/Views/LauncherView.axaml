<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LaunchFast.App.ViewModels"
             xmlns:conv="using:LaunchFast.App.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="LaunchFast.App.Views.LauncherView"
             x:DataType="vm:LauncherViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource Surface0Brush}">

    <UserControl.Resources>
        <conv:PathToBitmapConverter x:Key="PathToBitmap" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,11">
                <Button Grid.Column="0" Classes="btn" Content="Open project…"
                        Click="OnOpenProject" Margin="0,0,10,0" />
                <Button Grid.Column="1" Classes="btn" Content="Register workspace…"
                        Click="OnRegisterWorkspace" />
                <Button Grid.Column="2" Classes="btn accent"
                        HorizontalAlignment="Right" Margin="0,0,12,0"
                        IsVisible="{Binding HasUpdate}"
                        Content="{Binding UpdateBannerText}"
                        Click="OnOpenUpdate" />
                <TextBlock Grid.Column="3" Classes="count-pill"
                           Text="{Binding Cards.Count, StringFormat='{}{0} projects'}" />
            </Grid>
        </Border>

        <!-- Card grid -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Cards}" Margin="20,20,20,24"
                          HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectCardViewModel">
                        <Button Classes="card" Margin="7"
                                Command="{Binding $parent[ItemsControl].((vm:LauncherViewModel)DataContext).OpenDetailCommand}"
                                CommandParameter="{Binding}">
                            <Border Classes="card-surface">
                                <Grid ColumnDefinitions="Auto,14,*">
                                    <!-- Squircle app icon (56px) -->
                                    <Border Grid.Column="0" Width="56" Height="56"
                                            CornerRadius="{DynamicResource IconRadiusLg}"
                                            ClipToBounds="True" VerticalAlignment="Top"
                                            BoxShadow="0 2 5 0 #2E000000">
                                        <Panel>
                                            <!-- Gradient squircle fallback -->
                                            <Panel IsVisible="{Binding IconPath, Converter={x:Static ObjectConverters.IsNull}}">
                                                <Panel.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                        <GradientStop Offset="0" Color="#3DBE8B" />
                                                        <GradientStop Offset="1" Color="#1E8E64" />
                                                    </LinearGradientBrush>
                                                </Panel.Background>
                                                <TextBlock Text="📱" FontSize="26"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Panel>
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding IconPath, Converter={StaticResource PathToBitmap}}" />
                                        </Panel>
                                    </Border>

                                    <!-- Body -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text1Brush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Text2Brush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Version}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Project.Path}" />
                                        </TextBlock>

                                        <!-- Badges (existing fastlane projects) -->
                                        <WrapPanel Margin="0,11,0,0" IsVisible="{Binding !NeedsSetup}">
                                            <Border Classes="badge" IsVisible="{Binding HasIos}">
                                                <TextBlock Text="iOS" />
                                            </Border>
                                            <Border Classes="badge" IsVisible="{Binding HasAndroid}">
                                                <TextBlock Text="Android" />
                                            </Border>
                                            <Border Classes="badge ok" IsVisible="{Binding HasMatch}">
                                                <TextBlock Text="match ✓" />
                                            </Border>
                                        </WrapPanel>

                                        <!-- Setup candidate (no fastlane yet) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding NeedsSetup}">
                                            <TextBlock Text="No fastlane"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Text2Brush}"
                                                       FontSize="12" Margin="0,0,10,0" />
                                            <Button Classes="btn accent" Content="Set up →"
                                                    Command="{Binding $parent[ItemsControl].((vm:LauncherViewModel)DataContext).OpenDetailCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
