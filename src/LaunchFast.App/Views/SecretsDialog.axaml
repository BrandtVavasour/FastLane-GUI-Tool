<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LaunchFast.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="400"
        x:Class="LaunchFast.App.Views.SecretsDialog"
        x:DataType="vm:SecretsDialogViewModel"
        x:CompileBindings="True"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Title="Add secrets">

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top"
                   Text="These secrets are stored in your macOS Keychain."
                   Opacity="0.7" Margin="0,0,0,12" TextWrapping="Wrap" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="Save" Click="OnSave" Classes="accent" />
        </StackPanel>

        <ScrollViewer MaxHeight="360">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SecretEntryViewModel">
                        <StackPanel Spacing="4" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="12" />
                            <TextBox Text="{Binding Value}" PasswordChar="•"
                                     Watermark="(leave blank to skip)" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
