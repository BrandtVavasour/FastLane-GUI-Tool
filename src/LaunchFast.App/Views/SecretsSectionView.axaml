<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LaunchFast.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="LaunchFast.App.Views.SecretsSectionView"
             x:DataType="vm:SecretsSectionViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource Surface0Brush}">

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,11">
                <Button Grid.Column="1" Classes="btn" Margin="0,0,8,0"
                        Content="Reveal all"
                        Command="{Binding ToggleRevealAllCommand}" />
                <Button Grid.Column="2" Classes="accent" Content="＋ Add secret"
                        Command="{Binding AddOrEditCommand}" />
            </Grid>
        </Border>

        <!-- Subbar -->
        <Border DockPanel.Dock="Top" Classes="subbar">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="h2" Text="Secrets &amp; credentials" />
                <TextBlock Grid.Column="1" Classes="lbl" Text="Auth"
                           Margin="16,0,8,0" />
                <Border Grid.Column="2" Classes="seg sm">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="seg-item" GroupName="auth"
                                     Content="ASC API key · recommended"
                                     IsChecked="{Binding UseAscApiKey, Mode=TwoWay}" />
                        <RadioButton Classes="seg-item" GroupName="auth"
                                     Content="Apple ID"
                                     IsChecked="{Binding UseAppleId, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="pill bad"
                        IsVisible="{Binding HasMissing}">
                    <TextBlock Text="{Binding MissingPillText}" />
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer>
            <StackPanel Margin="20,16,20,20" Spacing="14">

                <!-- Warning banner -->
                <Border Classes="banner" IsVisible="{Binding HasMissing}">
                    <Grid ColumnDefinitions="Auto,11,*">
                        <TextBlock Grid.Column="0" Text="⚠" FontSize="16"
                                   Foreground="{DynamicResource WarnTextBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarnTextBrush}"
                                       Text="{Binding BannerText}" />
                            <ItemsControl ItemsSource="{Binding MissingNames}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Classes="code-chip">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Secret list -->
                <Border Classes="listcard">
                    <ItemsControl ItemsSource="{Binding Secrets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SecretRowViewModel">
                                <Border Classes="lrow">
                                    <Grid ColumnDefinitions="Auto,12,*,Auto">
                                        <!-- Icon chip -->
                                        <Border Grid.Column="0" Classes="lic"
                                                Classes.blue="{Binding IconBlue}"
                                                Classes.neutral="{Binding IconNeutral}"
                                                Classes.red="{Binding IconRed}">
                                            <TextBlock Text="🔒" FontSize="15" />
                                        </Border>

                                        <!-- Main -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <TextBlock Classes="ltitle mono" Text="{Binding Name}"
                                                           VerticalAlignment="Center" />
                                                <Border Classes="pill"
                                                        Classes.ok="{Binding IsSet}"
                                                        Classes.bad="{Binding IsMissing}">
                                                    <TextBlock Text="{Binding StatusText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="lsub" Text="{Binding Description}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Classes="lsub mono"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       Text="{Binding Display}"
                                                       IsVisible="{Binding IsSet}" />
                                        </StackPanel>

                                        <!-- Meta -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    Spacing="10" VerticalAlignment="Center">
                                            <Border Classes="src">
                                                <TextBlock Text="{Binding SourceText}" />
                                            </Border>
                                            <Button Classes="btn small"
                                                    Classes.accent="{Binding ActionIsAccent}"
                                                    Content="{Binding ActionText}"
                                                    Command="{Binding $parent[ItemsControl].((vm:SecretsSectionViewModel)DataContext).AddOrEditCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Resolution-order note -->
                <TextBlock FontSize="11.5" Foreground="{DynamicResource Text3Brush}"
                           TextWrapping="Wrap">
                    <Run Text="Resolution order when a lane runs:" />
                    <Run Text=" 1. " FontWeight="SemiBold" />
                    <Run Text="process / CI environment variables →" />
                    <Run Text=" 2. " FontWeight="SemiBold" />
                    <Run Text=".env &amp; .env.default →" FontFamily="{DynamicResource MonoFontFamily}" />
                    <Run Text=" 3. " FontWeight="SemiBold" />
                    <Run Text="macOS Keychain. Secrets never leave this machine." />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
